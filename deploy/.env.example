# Copia este fichero a .env y ajústalo antes de levantar nada.

# --- Base de datos ---
POSTGRES_USER=vigia
POSTGRES_PASSWORD=pon-una-clave-larga-aqui
POSTGRES_DB=vigia
# Cadena que usa el servidor para conectarse (host 'db' = servicio de compose)
DATABASE_URL=postgresql://vigia:pon-una-clave-larga-aqui@db:5432/vigia?schema=public

# --- Servidor ---
PORT=8080
HOST=0.0.0.0
# Clave para firmar las sesiones del panel. Cadena aleatoria larga.
JWT_SECRET=cambia-esto-por-algo-aleatorio-y-largo
# Origen(es) del panel permitido(s) para CORS. Separar por comas.
PANEL_ORIGIN=https://vigia.miempresa.com
# Carpeta de datos (capturas). En compose se monta como volumen ./data
DATA_DIR=/data
# Carpeta con el código/binarios del agente para la página de descargas
AGENT_DIST_DIR=/agent
MAX_UPLOAD_MB=8

# --- Admin inicial (solo se usa la primera vez, en el seed) ---
SEED_ADMIN_EMAIL=admin@miempresa.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-al-entrar

# --- Nginx / dominio ---
PANEL_SERVER_NAME=vigia.miempresa.com
